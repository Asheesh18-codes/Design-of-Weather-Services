# Frontend Next.js Environment Configuration
# Copy this file to .env.local and update the values

# API Base URLs (NEXT_PUBLIC_ prefix required for client-side access)
NEXT_PUBLIC_NODE_API_BASE=http://localhost:5000/api
NEXT_PUBLIC_PYTHON_NLP_BASE=http://localhost:8000

# Legacy API Base (for backward compatibility)
NEXT_PUBLIC_API_BASE=http://localhost:5000/api

# Map Configuration
NEXT_PUBLIC_MAPBOX_KEY=your_mapbox_api_key_here
NEXT_PUBLIC_MAP_STYLE=mapbox://styles/mapbox/streets-v11
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=39.8283
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=-98.5795
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=4

# Application Configuration
NEXT_PUBLIC_APP_TITLE=Aviation Weather Briefing
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_NLP_DIRECT=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=true

# Development Configuration
NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_MOCK_BACKEND=false
